{
  "manifest_version": 3,
  "name": "Apply Buddy",
  "version": "1.0.0",
  "description": "A Chrome extension which auto-fills job details onto google sheets, so you can keep track of job applications faster.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "identity"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "698868351089-n5dgcbddqf6qcgidhpra2158h7tha995.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/spreadsheets"]
  }
}
